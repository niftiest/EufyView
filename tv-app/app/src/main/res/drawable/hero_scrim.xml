<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-up darkening so the hero title/subtitle stay legible over any image
     and the hero blends into the rows area below. angle=90 → origin at bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F20B0E13"
        android:centerColor="#660B0E13"
        android:endColor="#000B0E13"
        android:type="linear" />
</shape>
