<?xml version="1.0" encoding="utf-8"?>
<!-- Top-bar button (Settings / overlay). Clearly fills with the accent colour on
     D-pad focus so it's obvious which control is selected before pressing OK. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2F7FE0" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A9EFF" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C2635" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#33425A" />
        </shape>
    </item>
</selector>
